    "test:chat-browser": "node test/chat-browser.mjs",
    "test:chat-recovery-browser": "node test/chat-recovery-browser.mjs",
    "test:input-preview-browser": "node test/input-preview-browser.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "dompurify": "3.4.15",
    "esbuild": "0.25.12",
    "marked": "18.0.12"
  },
  "devDependencies": {
    "playwright-core": "1.55.1"
  }
}
