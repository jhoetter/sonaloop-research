{
  "name": "@sonaloop/mcp-app-reference-host",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "*.mjs",
    "README.md",
    "config.example.json",
    "web",
    "dist",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "node build.mjs",
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
